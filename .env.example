# ClaimGuard Environment Configuration
# Copy this file to .env and configure values

# Google Gemini / Gemma API Key (leave blank for offline mock mode)
GEMINI_API_KEY=

# Default multimodal model string for extraction
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server Port (default 8000)
PORT=8000

# CORS Allowed Origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite Database File Path
CLAIMGUARD_DB_FILE=claimguard.db
