# Copy to .env locally and add your key there. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Legacy alias; GEMINI_MODEL takes precedence.
GEMMA_MODEL=
FORCE_MOCK=0
USE_LOCAL_LLM=0
# For any internet-facing deployment, use APP_ENV=production and set a long random token.
APP_ENV=development
CLAIMGUARD_API_TOKEN=
# Replace with the exact deployed frontend origin before public deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Optional local data directory for case documents (defaults to ./data).
# CLAIMGUARD_DATA_DIR=data
